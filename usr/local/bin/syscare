#!/usr/bin/env bash

set -euo pipefail

# Target architectures
TARGET_ARCH="Architectures: amd64"

# Opera keyring path
OPERA_KEYRING="/usr/share/keyrings/opera-browser.gpg"

# Opera signed by path
OPERA_SIGNEDBY="Signed-By: $OPERA_KEYRING"

# Opera key URL
OPERA_KEYURL="https://deb.opera.com/archive.key"

# Opera sources path
OPERA_FILE="/etc/apt/sources.list.d/opera-stable.sources"

# Architecture files path
ARCH_FILES=(
    "/etc/apt/sources.list.d/google-chrome.sources"
    "/etc/apt/sources.list.d/docker.sources"
)

# Define updated default value
UPDATED=0

# Prompt for sudo password upfront
sudo -v

# Fix architecture function
archfix()
{
    local file="$1"
    [[ -f "$file" ]] || return 0

    if ! grep -Fxq "$TARGET_ARCH" "$file";
    then
        if grep -q '^Types:' "$file";
        then
            sudo sed -i "/^Types:/a $TARGET_ARCH" "$file"
        else
            echo "$TARGET_ARCH" | sudo tee -a "$file" > /dev/null
        fi

        echo "Added '$TARGET_ARCH' to $file"
        UPDATED=1
    fi
}

# Opera signedby function
operasignedby()
{
    [[ -f "$OPERA_FILE" ]] || return 0

    # Create a temporary file
    local tmpfile=$(mktemp)

    # Remove duplicate entries and clean up the file
    awk -v signedby="$OPERA_SIGNEDBY" '
    BEGIN { RS=""; FS="\n"; ORS="\n\n" }
    {
        if (NF == 0) next

        key = ""
        for (i=1; i<=NF; i++) {
            if ($i ~ /^(Types|URIs|Suites|Components):/) {
                key = key $i "\n"
            }
        }

        if (!seen[key]) {
            seen[key] = 1
            for (i=1; i<=NF; i++) {
                if ($i ~ /^Signed-By:[[:space:]]*$/) {
                    $i = "Signed-By: " signedby
                }
            }
            print
        }
    }' "$OPERA_FILE" > "$tmpfile"

    # Check if the cleaned content is different from original
    if ! cmp -s "$OPERA_FILE" "$tmpfile"; then
        sudo cp "$tmpfile" "$OPERA_FILE"
        echo "Cleaned and fixed duplicate entries in $OPERA_FILE"
        UPDATED=1
    else
        # Even if no duplicates, check for empty Signed-By
        if grep -Eq '^Signed-By:[[:space:]]*$' "$OPERA_FILE"; then
            sudo sed -i "s|^Signed-By:[[:space:]]*$|$OPERA_SIGNEDBY|" "$OPERA_FILE"
            echo "Fixed empty Signed-By in $OPERA_FILE"
            UPDATED=1
        fi
    fi

    rm -f "$tmpfile"
}

# Opera install key function
operakeyring()
{
    local instkey=0

    if [[ ! -f "$OPERA_KEYRING" ]];
    then
        instkey=1
    elif ! gpg --show-keys "$OPERA_KEYRING" 2>/dev/null | grep -q "11EE8C00B693A745";
    then
        instkey=1
    fi

    if [[ "$instkey" -eq 1 ]];
    then
        sudo mkdir -p /usr/share/keyrings
        wget -qO- "$OPERA_KEYURL" | gpg --dearmor | sudo tee "$OPERA_KEYRING" > /dev/null
        sudo chmod 644 "$OPERA_KEYRING"
        echo "Installed Opera signing key"
        UPDATED=1
    fi
}

# Execute maintenance function
systemrefresh()
{
    echo "Running system maintenance..."
    sudo apt -y update
    sudo apt -y upgrade
    sudo apt -y dist-upgrade
    sudo apt -y autoremove
    sudo apt -y clean
    sudo apt -y autoclean

    if apt --help 2>/dev/null | grep -q modernize-sources;
    then
        sudo apt -y modernize-sources
    fi

    echo "System maintenance completed"
}

# Main execution
for file in "${ARCH_FILES[@]}";
do
    archfix "$file"
done

operasignedby
operakeyring
systemrefresh

# Wait 2 second before exit
echo "Script completed | Exiting in 2 second..."
sleep 2